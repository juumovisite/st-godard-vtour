{
  "id": "infospot",
  "label": "Tag info (hotspot)",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "identifiant_hotspot": {
        "type": "Text",
        "config": {
          "label": "Identifiant hotspot KRPano",
          "placeholder": "spot2000673478"
        }
      },
      "nom_scene_krpano": {
        "type": "Text",
        "config": {
          "label": "Scene KRpano (hotspots ajoutes via l'espace client)",
          "placeholder": "scene_a5_55"
        }
      },
      "ath": {
        "type": "Number",
        "config": {
          "label": "ath / yaw (hotspots ajoutes via l'espace client)"
        }
      },
      "atv": {
        "type": "Number",
        "config": {
          "label": "atv / pitch (hotspots ajoutes via l'espace client)"
        }
      },
      "titre": {
        "type": "Text",
        "config": {
          "label": "Titre",
          "placeholder": "Pile P1"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "Texte descriptif du point d'interet...",
          "multi": "paragraph,strong,em,hyperlink,list-item"
        }
      },
      "photos": {
        "type": "Group",
        "config": {
          "label": "Photos",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Image",
                "constraint": {},
                "thumbnails": []
              }
            },
            "legende": {
              "type": "Text",
              "config": {
                "label": "Legende",
                "placeholder": "Detail vue Nord-Est"
              }
            }
          }
        }
      },
      "video_url": {
        "type": "Text",
        "config": {
          "label": "URL Video (optionnel)",
          "placeholder": "https://vimeo.com/..."
        }
      },
      "categorie": {
        "type": "Select",
        "config": {
          "label": "Categorie",
          "options": ["Inspection", "Information", "Travaux", "Historique"],
          "default_value": "Information"
        }
      }
    }
  },
  "status": true
}
